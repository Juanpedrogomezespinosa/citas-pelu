{
  "name": "peluqueria-frontend",
  "version": "1.0.0",
  "description": "Panel de gestión de citas de la peluquería (Astro + React + Tailwind CSS)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
