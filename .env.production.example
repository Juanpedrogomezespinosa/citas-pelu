# =============================================================================
# Variables de producción para docker-compose.prod.yml
#   cp .env.production.example .env.production   (NO lo subas al repositorio)
# Genera secretos con: openssl rand -hex 32
# =============================================================================

# URL pública del panel (https). Se usa para la cookie, CORS y los webhooks.
PUBLIC_BASE_URL=https://citas.tu-peluqueria.es
HTTP_PORT=80
# Proxies delante de la API: 2 = proxy TLS + nginx (lo habitual); 1 = nginx directo a Internet
TRUST_PROXY=2
APP_TIMEZONE=Europe/Madrid
BUSINESS_NAME=Tu Peluquería
BUSINESS_OPEN_TIME=09:00
BUSINESS_CLOSE_TIME=20:00

# --- Secretos (obligatorios) ---
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
JWT_SECRET=
# Token para Prometheus (opcional; si lo usas, guárdalo también en ops/prometheus/metrics-token)
METRICS_TOKEN=

# --- Backups ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_HOUR=03

# --- WhatsApp: console | twilio | meta (ver README y docs/whatsapp-plantillas.md) ---
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SID_CONFIRMACION=
TWILIO_CONTENT_SID_RECORDATORIO=
TWILIO_CONTENT_SID_CAMBIO=
TWILIO_CONTENT_SID_CANCELACION=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_TEMPLATE_CONFIRMACION=
META_TEMPLATE_RECORDATORIO=
META_TEMPLATE_CAMBIO=
META_TEMPLATE_CANCELACION=

# --- RGPD ---
RGPD_ANONIMIZACION_AUTOMATICA=false
RGPD_RETENCION_MESES=36
