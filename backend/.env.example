# =============================================================================
# Configuración del backend. Copia este archivo a `.env` y rellena los valores.
# NUNCA subas el `.env` real al repositorio.
# =============================================================================

# --- Servidor ---
NODE_ENV=development
PORT=4000
# Zona horaria del salón: todas las fechas de citas se interpretan en ella.
APP_TIMEZONE=Europe/Madrid
# Orígenes permitidos por CORS (separados por comas)
CORS_ORIGINS=http://localhost:4321
# URL pública del backend (necesaria para validar la firma de los webhooks de Twilio)
PUBLIC_BASE_URL=http://localhost:4000
# Nº de proxies de confianza delante de la API (0 = ninguno; 1 = nginx o ngrok; 2 = proxy TLS + nginx)
TRUST_PROXY=0

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=peluqueria_app
DB_PASSWORD=peluqueria_dev_password
DB_NAME=peluqueria
DB_CONNECTION_LIMIT=10

# --- Autenticación (JWT) ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_de_al_menos_32_caracteres
JWT_EXPIRES_IN=8h

# Administrador inicial (usado por `npm run seed:admin`)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@peluqueria.local
ADMIN_PASSWORD=CambiaEstaClave123!

# --- Negocio ---
BUSINESS_NAME=Peluquería Demo
BUSINESS_OPEN_TIME=09:00
BUSINESS_CLOSE_TIME=20:00
SLOT_INTERVAL_MINUTES=15

# --- WhatsApp ---
# Proveedor: console (desarrollo, solo registra en consola) | twilio | meta
WHATSAPP_PROVIDER=console
# Prefijo de país por defecto para normalizar teléfonos sin prefijo
WHATSAPP_DEFAULT_COUNTRY_CODE=34
# Habilita POST /api/webhooks/whatsapp/simular (solo desarrollo; prohibido en producción)
WHATSAPP_SIMULATOR_ENABLED=true

# Twilio (https://console.twilio.com) -> Messaging -> WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número remitente, p. ej. whatsapp:+14155238886 (sandbox)
TWILIO_WHATSAPP_FROM=
# Content SID de las plantillas aprobadas (necesarias en producción para escribir
# fuera de la ventana de 24 h). Textos a enviar a aprobación: docs/whatsapp-plantillas.md
TWILIO_CONTENT_SID_CONFIRMACION=
TWILIO_CONTENT_SID_RECORDATORIO=
TWILIO_CONTENT_SID_CAMBIO=
TWILIO_CONTENT_SID_CANCELACION=

# Meta WhatsApp Cloud API (https://developers.facebook.com)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# Token que tú eliges y pegas en la configuración del webhook en Meta
META_VERIFY_TOKEN=
# App Secret, para validar la firma X-Hub-Signature-256
META_APP_SECRET=
META_API_VERSION=v21.0
# Nombres de las plantillas aprobadas (ver docs/whatsapp-plantillas.md) y su idioma
META_TEMPLATE_CONFIRMACION=
META_TEMPLATE_RECORDATORIO=
META_TEMPLATE_CAMBIO=
META_TEMPLATE_CANCELACION=
META_TEMPLATE_LANGUAGE=es

# --- Recordatorios automáticos ---
REMINDER_ENABLED=true
REMINDER_HOURS_BEFORE=24
# Expresión cron: cada 10 minutos
REMINDER_CRON=*/10 * * * *

# --- Cola de notificaciones (outbox) ---
OUTBOX_INTERVAL_SECONDS=15

# --- Redis (opcional): rate limiting compartido entre varias instancias ---
# REDIS_URL=redis://localhost:6379

# --- Monitorización (opcional): GET /api/metrics con "Authorization: Bearer <token>" ---
# METRICS_TOKEN=un_token_largo_y_aleatorio

# --- RGPD ---
# Anonimiza automáticamente (job mensual) clientes sin actividad en N meses.
# Desactivado por defecto: es irreversible. Revisa la política del salón antes.
RGPD_ANONIMIZACION_AUTOMATICA=false
RGPD_RETENCION_MESES=36
