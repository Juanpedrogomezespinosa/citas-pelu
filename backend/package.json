{
  "name": "peluqueria-backend",
  "version": "1.0.0",
  "description": "API REST (Express + MySQL, MVC en TypeScript) para la gestión de citas de una peluquería con notificaciones por WhatsApp",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/sql','dist/db/sql',{recursive:true})\"",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test test/unit/*.test.ts",
    "test:integration": "tsx --import ./test/setup-env.ts --test --test-concurrency=1 test/integration/*.test.ts",
    "test:all": "npm test && npm run test:integration",
    "db:migrate": "tsx src/db/migrate.ts latest",
    "db:rollback": "tsx src/db/migrate.ts rollback",
    "db:status": "tsx src/db/migrate.ts status",
    "db:seed": "tsx src/db/seed.ts",
    "db:migrate:prod": "node dist/db/migrate.js latest",
    "db:seed:prod": "node dist/db/seed.js",
    "whatsapp:test": "tsx src/tools/whatsapp-test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.5",
    "node-cron": "^4.6.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.3.0",
    "twilio": "^6.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.18.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
